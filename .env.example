# 複製成 .env 後填入實際值。.env 不會進版控（見 .gitignore）。
# 欄位說明與取得方式見 README「外部平台設定」。

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app

# 本機與正式都用 PostgreSQL。
# 本機：先在本機的 PostgreSQL 建一個資料庫（見 README 的設定說明）。
# 正式：改成 Cloud SQL for PostgreSQL 的連線字串。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/line_backup_system

# --- LINE Messaging API ---
# LINE Developers Console → Channel → Basic settings / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Notion ---
# Notion Integration 的 Internal Integration Token（secret_ 開頭）
NOTION_TOKEN=
# 要寫入的 Notion Database ID（32 碼）
NOTION_DATABASE_ID=

# --- Google Drive ---
# Service Account JSON 金鑰檔的路徑
GOOGLE_APPLICATION_CREDENTIALS=
# 備份根資料夾的 Drive folder ID（需分享給 Service Account）
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- 備份行為設定（可留空用預設值）---
MAX_BACKUP_ATTEMPTS=3
MAX_MEDIA_FILE_SIZE_MB=50
