# 複製成 .env 後填入實際值。.env 不會進版控（見 .gitignore）。
# 欄位說明與取得方式見 README「外部平台設定」。

# --- Django ---
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev

# 本機與正式都用 PostgreSQL。
# 本機：在專案根目錄執行 `docker compose up -d`，下面的值不用改。
# 正式：改成 Cloud SQL for PostgreSQL 的連線字串。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/line_backup_system

# --- LINE Messaging API ---
# Channel 由 LINE Official Account Manager 啟用 Messaging API 時自動建立（見 README）。
# 值都在 LINE Developers Console → 該 channel 裡取得：
# Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# --- Notion ---
# Notion Integration 的 Internal Integration Token（secret_ 開頭）
NOTION_TOKEN=
# 要寫入的 Notion Database ID（32 碼）
NOTION_DATABASE_ID=

# --- Google Drive ---
# Service Account JSON 金鑰檔的路徑
GOOGLE_APPLICATION_CREDENTIALS=
# 備份根資料夾的 Drive folder ID（需分享給 Service Account）
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- 備份行為設定（可留空用預設值）---
MAX_BACKUP_ATTEMPTS=3
MAX_MEDIA_FILE_SIZE_MB=50
